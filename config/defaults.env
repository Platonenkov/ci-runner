# Shared settings for every runner host. A file in servers/ overrides any of them for one host; deploy merges
# the two into /etc/ci-runner/runner.env on the server. Not a secret: the token lives only in /etc/ci-runner/token.

# Organization the runners register in, and its runner group (1 is the Default group).
ORG=StaticBit-io
RUNNER_GROUP_ID=1

# Comma-separated labels. Workflows select the runner with runs-on: ${{ vars.LINUX_RUNNER || 'ubuntu-latest' }},
# where LINUX_RUNNER is one of these labels.
RUNNER_LABELS=staticbit-linux

# Concurrent jobs on the host. Each slot is one container that runs one job and is then replaced by a fresh one.
SLOTS=2

# Memory limit per slot; the hosted ubuntu-latest runner for private repositories has 7 GB.
SLOT_MEMORY=7g

# A slot keeps its Docker image cache between jobs; above this size the next job starts with an empty one.
DOCKER_CACHE_LIMIT_MB=25000

# A job running longer than this is killed and reported as failed, whatever its own timeout-minutes says; a stuck
# step would otherwise hold the slot for GitHub's default six hours. 0 turns the limit off.
JOB_TIMEOUT_MINUTES=120

# Runner image tag on the host, and the runner version baked into it (empty: the latest release).
IMAGE=ci-runner:latest
RUNNER_VERSION=

# Sysbox gives each slot its own Docker daemon without --privileged.
SYSBOX_VERSION=0.7.1
SYSBOX_SHA256=9d6d5484f980d0a17f86c492c1262015c2afb66280bdb97215b79fde6a0261c5
